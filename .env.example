# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required in production so NextAuth issues correct callback/redirect URLs. Local dev doesn't
# need this — it's auto-detected from the request.
# AUTH_URL="https://esports-tools.com"
# APP_URL="https://esports-tools.com"

# Formation is the identity provider for this whole product family (see that repo's lib/oauth/).
# FORMATION_ISSUER must be Formation's own public APP_URL exactly — it's checked against the
# `iss` claim in every id_token, so a mismatch (e.g. an internal Docker hostname instead of the
# public URL) fails every sign-in. Register this app as an OAuth client on Formation first (see
# that repo's lib/oauth/README or deploy notes) to get the client id/secret below.
# FORMATION_ISSUER="https://formation.yourdomain.example"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# Where the "Open Formation" / "Open Vault" launcher cards on /home point. Defaults match this
# family's own domains — override only if you're running a fork under different hostnames.
# FORMATION_URL="https://formation.yourdomain.example"
# VAULT_URL="https://vault.yourdomain.example"

# Docker self-hosting only (see docker-compose.yml / the Caddyfile in the formation repo, which
# is what actually serves this app — see that repo for why). DOMAIN is what Caddy serves this app
# on.
# DOMAIN="yourdomain.example"

# Posts waitlist signups (e.g. for Atlas) to this Discord webhook — Server Settings ->
# Integrations -> Webhooks. Leave unset and signups are just silently accepted with no error.
# FEEDBACK_DISCORD_WEBHOOK_URL=""
