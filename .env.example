# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required in production so NextAuth issues correct callback/redirect URLs. Local dev doesn't
# need this — it's auto-detected from the request.
# AUTH_URL="https://esports-tools.com"
# APP_URL="https://esports-tools.com"

# Formation is the identity provider for this whole product family (see that repo's lib/oauth/).
# FORMATION_ISSUER must be Formation's own public APP_URL exactly — it's checked against the
# `iss` claim in every id_token, so a mismatch (e.g. an internal Docker hostname instead of the
# public URL) fails every sign-in. Register this app as an OAuth client on Formation first (see
# that repo's lib/oauth/README or deploy notes) to get the client id/secret below.
# FORMATION_ISSUER="https://formation.yourdomain.example"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""

# Where the "Open Formation" / "Open Vault" launcher cards on /home point. Defaults match this
# family's own domains — override only if you're running a fork under different hostnames.
# FORMATION_URL="https://formation.yourdomain.example"
# VAULT_URL="https://vault.yourdomain.example"

# This hub is ALSO its own OpenID Connect identity provider (see lib/oauth/ and app/oauth/*) —
# Vault signs in "with esports-tools.com" against these routes, which are themselves backed
# internally by the Formation sign-in above. Generate the signing keypair once with:
#   node -e "const{privateKey,publicKey}=require('crypto').generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('HUB_OIDC_PRIVATE_KEY='+Buffer.from(privateKey).toString('base64url'));console.log('HUB_OIDC_PUBLIC_KEY='+Buffer.from(publicKey).toString('base64url'))"
# Required before any /oauth/* route works — there's no fallback.
# HUB_OIDC_PRIVATE_KEY=""
# HUB_OIDC_PUBLIC_KEY=""

# Authorization codes here are self-contained encrypted JWEs rather than DB rows (this app has no
# database) — this is the symmetric key they're encrypted with. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# HUB_CODE_ENCRYPTION_KEY=""

# Registered OAuth clients (e.g. Vault), as a JSON array — there's no database here to store these
# in, so it's this single env var instead. clientSecretHash is sha256(secret) as hex, computed with:
#   node -e "console.log(require('crypto').createHash('sha256').update('paste-the-plaintext-secret').digest('hex'))"
# redirectUris must match exactly (no wildcards) — see lib/oauth/clients.ts.
# HUB_OAUTH_CLIENTS='[{"clientId":"vault","clientSecretHash":"...","name":"Vault","redirectUris":["https://vault.yourdomain.example/api/auth/callback/esports-tools"]}]'

# Docker self-hosting only (see docker-compose.yml / the Caddyfile in the formation repo, which
# is what actually serves this app — see that repo for why). DOMAIN is what Caddy serves this app
# on.
# DOMAIN="yourdomain.example"

# Posts waitlist signups (e.g. for Atlas) to this Discord webhook — Server Settings ->
# Integrations -> Webhooks. Leave unset and signups are just silently accepted with no error.
# FEEDBACK_DISCORD_WEBHOOK_URL=""
